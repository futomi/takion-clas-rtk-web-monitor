# Apache 用の配信設定。静的書き出し（STATIC_EXPORT=true）で出力した out/ 配下へ
# そのまま含まれるので、FTP で上げれば有効になります。
#
# 静的配信では next.config.ts の headers() が働きません（応答を組み立てるのは
# Next ではなく Apache のため）。同じ内容をここで付け直しています。
# 中身を変えるときは next.config.ts 側と揃えてください。

<IfModule mod_headers.c>
  # このアプリが外部と通信するのは地図タイルの取得だけ。それ以外は自オリジンに閉じる。
  # script-src の 'unsafe-inline' は Next のハイドレーション用インラインスクリプト、
  # worker-src の blob: は MapLibre GL のタイル描画ワーカーに要る。
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' https://tile.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # JS・CSS・フォントはファイル名にビルドごとのハッシュが入る。
  # 内容が変われば名前も変わるので、長期間キャッシュさせて問題ない。
  # HTML は対象外。ここを固定すると新しいビルドへ切り替わらなくなる。
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 転送量を減らす。JS は無圧縮で 1.6 MB、gzip で 0.4 MB になる。
# woff2 は既に圧縮済みなので対象へ入れない。
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Web Serial API は保護されたコンテキストでしか動かない。
# HTTP で開かれた場合に備えて HTTPS へ寄せる。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
